@model AdminInventoryAdjustViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Adjust Inventory";
}

<div class="adm-page-header">
    <h1>Adjust Inventory</h1>
    <a asp-controller="AdminInventory" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form asp-controller="AdminInventory" asp-action="Adjust" method="post" style="max-width:480px;">
    @Html.AntiForgeryToken()

    <div class="adm-form-section">
        <div class="mb-3">
            <label asp-for="ProductId" class="form-label"></label>
            <input asp-for="ProductId" class="form-control" type="number" min="1" />
            @if (!string.IsNullOrEmpty(Model.ProductName))
            {
                <div class="form-text">@Model.ProductName</div>
            }
            <span asp-validation-for="ProductId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="QuantityChange" class="form-label"></label>
            <input asp-for="QuantityChange" class="form-control" type="number" step="0.01" />
            <div class="form-text">Use a positive number to add stock, negative to remove.</div>
            <span asp-validation-for="QuantityChange" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Reason" class="form-label"></label>
            <input asp-for="Reason" class="form-control" placeholder="e.g. Stock received, Damaged goods" />
            <span asp-validation-for="Reason" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Apply Adjustment</button>
        <a asp-controller="AdminInventory" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
