    // ── SVG Chart Engines ─────────────────────────────────────────────────────

    function drawDailySalesChart(trends) {
        const svg = document.getElementById('salesTrendSvg');
        svg.innerHTML = '';

        if (!trends || trends.length === 0) {
            svg.innerHTML = '<text x="400" y="125" text-anchor="middle" fill="#6b7280" font-weight="600">No trend data available for selected period.</text>';
            return;
        }

        const width = 800;
        const height = 250;
        const padding = { top: 30, right: 40, bottom: 40, left: 60 };

        const maxSales = Math.max(...trends.map(t => t.netSales), 5000);
        const maxOrders = Math.max(...trends.map(t => t.orderCount), 5);

        // Helper coords converter
        const getX = (index) => padding.left + (index / (trends.length - 1 || 1)) * (width - padding.left - padding.right);
        const getYLine = (val) => height - padding.bottom - (val / maxSales) * (height - padding.top - padding.bottom);
        const getYBar = (val) => (val / maxOrders) * (height - padding.top - padding.bottom);

        // Draw axes and grid lines
        let grids = '';
        for (let i = 0; i <= 4; i++) {
            const y = padding.top + (i / 4) * (height - padding.top - padding.bottom);
            const labelValue = maxSales - (i / 4) * maxSales;
            grids += `
                <line x1="${padding.left}" y1="${y}" x2="${width - padding.right}" y2="${y}" stroke="#f3f4f6" stroke-width="1.5" />
                <text x="${padding.left - 10}" y="${y + 4}" text-anchor="end" fill="#6b7280" font-size="10">₹${Math.round(labelValue).toLocaleString()}</text>
            `;
        }
        svg.innerHTML += grids;

        // Draw dates labels
        let datesLabels = '';
        const modulo = Math.ceil(trends.length / 8);
        trends.forEach((t, i) => {
            if (i % modulo === 0 || i === trends.length - 1) {
                const x = getX(i);
                const dt = new Date(t.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
                datesLabels += `
                    <text x="${x}" y="${height - 10}" text-anchor="middle" fill="#6b7280" font-size="10">${dt}</text>
                    <line x1="${x}" y1="${height - padding.bottom}" x2="${x}" y2="${height - padding.bottom + 5}" stroke="#d1d5db" stroke-width="1" />
                `;
            }
        });
        svg.innerHTML += datesLabels;

        // Draw order count bars (background, semi-transparent)
        const barWidth = Math.max(2, (width - padding.left - padding.right) / (trends.length * 2));
        let bars = '';
        trends.forEach((t, i) => {
            const x = getX(i) - barWidth / 2;
            const barHeight = getYBar(t.orderCount);
            const y = height - padding.bottom - barHeight;
            bars += `
                <rect x="${x}" y="${y}" width="${barWidth}" height="${barHeight}" fill="#e0f2fe" opacity="0.8" rx="2"
                      onmouseover="showChartTooltip(event, '${escapeHtml(new Date(t.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }))}<br/>Orders: <b>${t.orderCount}</b>')"
                      onmouseout="hideChartTooltip()" />
            `;
        });
        svg.innerHTML += bars;

        // Draw Sales line
        let pathD = '';
        trends.forEach((t, i) => {
            const x = getX(i);
            const y = getYLine(t.netSales);
            pathD += `${i === 0 ? 'M' : 'L'} ${x} ${y}`;
        });

        // Add sales area under line
        if (trends.length > 1) {
            const areaD = `${pathD} L ${getX(trends.length - 1)} ${height - padding.bottom} L ${getX(0)} ${height - padding.bottom} Z`;
            svg.innerHTML += `<path d="${areaD}" fill="url(#salesAreaGradient)" opacity="0.15" />`;
        }

        // Add SVG definitions (gradients)
        svg.innerHTML += `
            <defs>
                <linearGradient id="salesAreaGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#2e7d32" />
                    <stop offset="100%" stop-color="#2e7d32" stop-opacity="0" />
                </linearGradient>
            </defs>
        `;

        svg.innerHTML += `<path d="${pathD}" fill="none" stroke="#2e7d32" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />`;

        // Draw interactive sales data points
        let dots = '';
        trends.forEach((t, i) => {
            const x = getX(i);
            const y = getYLine(t.netSales);
            dots += `
                <circle cx="${x}" cy="${y}" r="5" fill="#fff" stroke="#2e7d32" stroke-width="3" style="cursor: pointer;"
                        onmouseover="showChartTooltip(event, '${escapeHtml(new Date(t.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }))}<br/>Sales: <b>₹${parseFloat(t.netSales).toFixed(2)}</b>')"
                        onmouseout="hideChartTooltip()" />
            `;
        });
        svg.innerHTML += dots;
    }

    function drawCategorySplitChart(categories) {
        const wrapper = document.getElementById('categorySplitWrapper');
        wrapper.innerHTML = '';

        if (!categories || categories.length === 0) {
            wrapper.innerHTML = '<p class="text-center text-muted mb-0 py-4">No category sales recorded during this period.</p>';
            return;
        }

        const maxSales = Math.max(...categories.map(c => c.netSales), 1);
        const totalSales = categories.reduce((sum, c) => sum + c.netSales, 0);

        categories.slice(0, 5).forEach(c => {
            const pctOfMax = (c.netSales / maxSales) * 100;
            const pctOfTotal = totalSales > 0 ? ((c.netSales / totalSales) * 100).toFixed(1) : '0.0';
            wrapper.innerHTML += `
                <div class="mb-1">
                    <div class="d-flex justify-content-between text-dark small fw-semibold mb-1">
                        <span>${escapeHtml(c.categoryName)}</span>
                        <span>₹${parseFloat(c.netSales).toLocaleString('en-IN', { maximumFractionDigits: 0 })} (${pctOfTotal}%)</span>
                    </div>
                    <div class="progress" style="height: 12px; background-color: #f3f4f6; border-radius: 6px; overflow: hidden;">
                        <div class="progress-bar" role="progressbar" style="width: ${pctOfMax}%; background-color: #2e7d32; border-radius: 6px;" aria-valuenow="${pctOfMax}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            `;
        });

        if (categories.length > 5) {
            const othersSum = categories.slice(5).reduce((sum, c) => sum + c.netSales, 0);
            const pctOfTotal = totalSales > 0 ? ((othersSum / totalSales) * 100).toFixed(1) : '0.0';
            const pctOfMax = (othersSum / maxSales) * 100;
            wrapper.innerHTML += `
                <div class="mb-1">
                    <div class="d-flex justify-content-between text-muted small fw-semibold mb-1">
                        <span>Other Categories</span>
                        <span>₹${parseFloat(othersSum).toLocaleString('en-IN', { maximumFractionDigits: 0 })} (${pctOfTotal}%)</span>
                    </div>
                    <div class="progress" style="height: 12px; background-color: #f3f4f6; border-radius: 6px; overflow: hidden;">
                        <div class="progress-bar" role="progressbar" style="width: ${pctOfMax}%; background-color: #9ca3af; border-radius: 6px;" aria-valuenow="${pctOfMax}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            `;
        }
    }

    function showChartTooltip(e, text) {
        const tooltip = document.getElementById('chartTooltip');
        tooltip.innerHTML = text;
        tooltip.style.display = 'block';

        // Position tooltip relative to mouse
        const xOffset = 15;
        const yOffset = -40;
        tooltip.style.left = (e.pageX + xOffset) + 'px';
        tooltip.style.top = (e.pageY + yOffset) + 'px';
    }

    function hideChartTooltip() {
        document.getElementById('chartTooltip').style.display = 'none';
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
</script>
