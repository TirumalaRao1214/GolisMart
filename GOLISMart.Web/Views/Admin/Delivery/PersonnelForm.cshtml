@model GOLISMart.Web.Models.AdminPersonnelFormViewModel
@{
    var isEdit = Model.PersonnelId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Delivery Person" : "Add Delivery Person";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="adm-page-header">
    <div>
        <a href="/admin/delivery/personnel" class="small text-muted text-decoration-none">← Delivery Personnel</a>
        <h1 class="mt-1">@(isEdit ? "Edit" : "Add") Delivery Person</h1>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7">
        @if (isEdit)
        {
        <form asp-controller="AdminDelivery" asp-action="EditPersonnel"
              asp-route-id="@Model.PersonnelId" method="post">
            @Html.AntiForgeryToken()
            <div class="adm-form-section">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ContactNumber" class="form-label"></label>
                    <input asp-for="ContactNumber" class="form-control" />
                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label"></label>
                    <input asp-for="UserId" class="form-control" placeholder="Leave blank if no app account" />
                    <div class="form-text">The ASP.NET Identity UserId of the delivery person's login account (if any).</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                    <div class="form-text text-danger small">
                        Deactivating a person with active deliveries will be blocked.
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/admin/delivery/personnel" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
        }
        else
        {
        <form asp-controller="AdminDelivery" asp-action="CreatePersonnel" method="post">
            @Html.AntiForgeryToken()
            <div class="adm-form-section">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ContactNumber" class="form-label"></label>
                    <input asp-for="ContactNumber" class="form-control" />
                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label"></label>
                    <input asp-for="UserId" class="form-control" placeholder="Leave blank if no app account" />
                    <div class="form-text">The ASP.NET Identity UserId of the delivery person's login account (if any).</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a href="/admin/delivery/personnel" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
        }
    </div>
</div>
