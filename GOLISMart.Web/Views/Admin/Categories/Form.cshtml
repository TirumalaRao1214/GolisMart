@model AdminCategoryFormViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var isEdit = Model.CategoryId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Category" : "Create Category";
    var action = isEdit ? "Edit" : "Create";
}

<div class="adm-page-header">
    <h1>@ViewData["Title"]</h1>
    <a asp-controller="AdminCategories" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form asp-controller="AdminCategories" asp-action="@action" asp-route-id="@(isEdit ? Model.CategoryId : null)"
      method="post" style="max-width:560px;">
    @Html.AntiForgeryToken()

    <div class="adm-form-section">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Slug" class="form-label"></label>
            <input asp-for="Slug" class="form-control" placeholder="e.g. fresh-vegetables" />
            <span asp-validation-for="Slug" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
        <div class="row g-2">
            <div class="col-sm-4">
                <label asp-for="SortOrder" class="form-label"></label>
                <input asp-for="SortOrder" class="form-control" type="number" min="0" />
            </div>
            @if (isEdit)
            {
                <div class="col-sm-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">@(isEdit ? "Save Changes" : "Create Category")</button>
        <a asp-controller="AdminCategories" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
