@model AdminProductFormViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var isEdit = Model.ProductId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Product" : "Create Product";
    var action = isEdit ? "Edit" : "Create";
    var routeId = isEdit ? new { id = Model.ProductId } : null;
}

<div class="adm-page-header">
    <h1>@ViewData["Title"]</h1>
    <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form asp-controller="AdminProducts" asp-action="@action" asp-route-id="@(isEdit ? Model.ProductId : null)"
      method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-md-8">
            <div class="adm-form-section">
                <fieldset>
                    <legend>Basic Information</legend>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <label asp-for="SKU" class="form-label"></label>
                            @if (isEdit)
                            {
                                <input asp-for="SKU" class="form-control" readonly />
                            }
                            else
                            {
                                <input asp-for="SKU" class="form-control" />
                            }
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">— Select Category —</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </fieldset>
            </div>

            <div class="adm-form-section">
                <fieldset>
                    <legend>Pricing</legend>
                    <div class="row g-2">
                        <div class="col-sm-4">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="OfferPrice" class="form-label"></label>
                            <input asp-for="OfferPrice" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label d-block">&nbsp;</label>
                            <div class="form-check mt-2">
                                <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                                <label asp-for="IsFeatured" class="form-check-label">Featured</label>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="adm-form-section">
                <fieldset>
                    <legend>Unit &amp; Stock</legend>
                    <div class="row g-2">
                        <div class="col-sm-3">
                            <label asp-for="UnitCode" class="form-label"></label>
                            <input asp-for="UnitCode" class="form-control" />
                            <span asp-validation-for="UnitCode" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-5">
                            <label asp-for="UnitLabel" class="form-label"></label>
                            <input asp-for="UnitLabel" class="form-control" placeholder="e.g. per kg, 500g pack" />
                            <span asp-validation-for="UnitLabel" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="LowStockThreshold" class="form-label"></label>
                            <input asp-for="LowStockThreshold" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>
                    <div class="row g-2 mt-1">
                        <div class="col-sm-4">
                            <label asp-for="InitialStock" class="form-label"></label>
                            <input asp-for="InitialStock" class="form-control" type="number" step="0.01" />
                        </div>
                        @if (isEdit)
                        {
                            <div class="col-sm-4 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsActive" class="form-check-label">Active</label>
                                </div>
                            </div>
                        }
                    </div>
                </fieldset>
            </div>
        </div>

        <div class="col-md-4">
            <div class="adm-form-section">
                <fieldset>
                    <legend>Product Image</legend>
                    @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                    {
                        <img src="@Model.ExistingImagePath" alt="Current image" class="img-fluid rounded mb-2" style="max-height:160px;" />
                        <p class="text-muted small">Upload a new image to replace.</p>
                    }
                    <input type="file" name="image" class="form-control" accept="image/*" />
                </fieldset>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-success">@(isEdit ? "Save Changes" : "Create Product")</button>
        <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
