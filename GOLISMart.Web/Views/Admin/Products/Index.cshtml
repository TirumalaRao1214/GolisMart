@model AdminProductListViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Products";
}

<div class="adm-page-header">
    <h1>Products</h1>
    <a asp-controller="AdminProducts" asp-action="Create" class="btn btn-success btn-sm">+ New Product</a>
</div>

@* ── Filters ──────────────────────────────────────────────────────────── *@
<form method="get" class="adm-card p-3 mb-3 d-flex flex-wrap gap-2 align-items-end">
    <div>
        <label class="form-label small mb-1">Search</label>
        <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Name or SKU" />
    </div>
    <div>
        <label class="form-label small mb-1">Category</label>
        <select name="categoryId" class="form-select form-select-sm">
            <option value="">All Categories</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small mb-1">Status</label>
        <select name="isActive" class="form-select form-select-sm">
            <option value="">All</option>
            <option value="true"  selected="@(Model.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
</form>

@if (!Model.ApiAvailable || Model.Products is null)
{
    <div class="alert alert-warning">Could not load products. The API may be unavailable.</div>
}
else if (Model.Products.Items.Count == 0)
{
    <div class="adm-card p-4 text-muted text-center">No products found.</div>
}
else
{
    <div class="adm-card">
        <div class="adm-table-responsive">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products.Items)
                    {
                        <tr>
                            <td class="text-muted small">@p.SKU</td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.ImagePath))
                                {
                                    <img src="@p.ImagePath" alt="" width="32" height="32" class="rounded me-2" style="object-fit:cover;" />
                                }
                                @p.Name
                            </td>
                            <td>@(p.CategoryName ?? "—")</td>
                            <td>
                                ₹@p.Price.ToString("N2")
                                @if (p.OfferPrice.HasValue)
                                {
                                    <small class="text-success ms-1">₹@p.OfferPrice.Value.ToString("N2")</small>
                                }
                            </td>
                            <td>
                                @p.QuantityOnHand
                                @if (p.QuantityOnHand <= p.LowStockThreshold)
                                {
                                    <span class="adm-badge adm-badge-low ms-1">Low</span>
                                }
                            </td>
                            <td>
                                <span class="adm-badge @(p.IsActive ? "adm-badge-active" : "adm-badge-inactive")">
                                    @(p.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="d-flex gap-1 flex-wrap">
                                <a asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                                @if (p.IsActive)
                                {
                                    <form asp-controller="AdminProducts" asp-action="Deactivate" asp-route-id="@p.Id"
                                          method="post" onsubmit="return confirm('Deactivate this product?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Pagination *@
    @if (Model.Products.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center">
                @for (var i = 1; i <= Model.Products.TotalPages; i++)
                {
                    var pg = i;
                    <li class="page-item @(pg == Model.Page ? "active" : "")">
                        <a class="page-link"
                           asp-controller="AdminProducts" asp-action="Index"
                           asp-route-page="@pg"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-isActive="@Model.IsActive">@pg</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
