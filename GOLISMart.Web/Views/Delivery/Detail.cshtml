@model GOLISMart.Web.Models.DeliveryDetailViewModel
@{
    var a = Model.Assignment;
    ViewData["Title"] = a is null ? "Delivery Detail" : $"Delivery {a.OrderNumber}";
}

<div class="container py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="DeliveryDashboard" asp-action="Index">My Deliveries</a></li>
            <li class="breadcrumb-item active">@(a?.OrderNumber ?? "Detail")</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] is string ok)
    { <div class="alert alert-success">@ok</div> }
    @if (TempData["ErrorMessage"] is string err)
    { <div class="alert alert-danger">@err</div> }

    @if (!Model.ApiAvailable || a is null)
    {
        <div class="alert alert-warning">Unable to load delivery details.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 fw-bold mb-0">Order @a.OrderNumber</h1>
            <span class="badge fs-6 @GetStatusBadge(a.OrderStatus)">@GetStatusLabel(a.OrderStatus)</span>
        </div>

        <div class="row g-3">
            @* ── Left ───────────────────────────────────────────────────────────── *@
            <div class="col-12 col-lg-7">

                @* Customer *@
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header bg-white fw-semibold">Customer</div>
                    <div class="card-body small">
                        <div class="fw-bold">@a.CustomerName</div>
                        <div class="text-muted">
                            <a href="tel:@a.CustomerPhone">@a.CustomerPhone</a>
                        </div>
                    </div>
                </div>

                @* Address *@
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header bg-white fw-semibold">Delivery Address</div>
                    <div class="card-body small">
                        <p class="mb-0">
                            @a.ShipToAddressLine1
                            @if (!string.IsNullOrEmpty(a.ShipToAddressLine2))
                            { <br />@a.ShipToAddressLine2 }
                            <br />@a.ShipToCity — @a.ShipToPincode
                        </p>
                        @if (!string.IsNullOrEmpty(a.DeliveryNotes))
                        {
                            <p class="mt-2 mb-0 text-muted">
                                <strong>Instructions:</strong> @a.DeliveryNotes
                            </p>
                        }
                    </div>
                </div>

                @* Items *@
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header bg-white fw-semibold">Items</div>
                    <div class="card-body small">
                        @a.ItemSummary
                    </div>
                </div>

                @* COD alert *@
                @if (a.IsCod)
                {
                    <div class="alert alert-warning">
                        <strong>Cash on Delivery</strong> — Collect ₹@a.TotalAmount.ToString("N2")<br />
                        <span class="small">Payment status: @a.PaymentStatus</span>
                    </div>
                }

                @* Status timeline *@
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white fw-semibold">Status Timeline</div>
                    <div class="card-body p-0">
                        @foreach (var h in a.StatusHistory)
                        {
                            <div class="d-flex align-items-start gap-3 p-3 border-bottom">
                                <span class="badge @GetStatusBadge(h.Status)">@GetStatusLabel(h.Status)</span>
                                <div class="flex-grow-1 small">
                                    @if (!string.IsNullOrEmpty(h.Notes))
                                    { <div>@h.Notes</div> }
                                    <div class="text-muted">@h.ChangedAt.ToString("dd MMM yyyy, h:mm tt") UTC</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ── Right: actions ─────────────────────────────────────────────────── *@
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm border-0 sticky-top" style="top:80px;">
                    <div class="card-header bg-white fw-semibold">Actions</div>
                    <div class="card-body">

                        @{ var nextStatuses = GetNextStatuses(a.OrderStatus); }

                        @if (!nextStatuses.Any())
                        {
                            <p class="text-muted small">No further actions available.</p>
                        }
                        else
                        {
                            @* Non-Delivered status updates *@
                            var nonDelivered = nextStatuses.Where(s => s != "Delivered").ToList();
                            @if (nonDelivered.Any())
                            {
                                <form asp-controller="DeliveryDashboard" asp-action="UpdateStatus"
                                      asp-route-orderId="@a.OrderId" method="post" class="mb-3">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-2">
                                        <label class="form-label small fw-semibold">Notes (required for Delivery Failed)</label>
                                        <textarea name="StatusNotes" class="form-control form-control-sm" rows="2"
                                                  placeholder="Optional notes or reason"></textarea>
                                    </div>
                                    @foreach (var ns in nonDelivered)
                                    {
                                        <button type="submit" name="newStatus" value="@ns"
                                                class="btn btn-sm @(ns == "DeliveryFailed" ? "btn-outline-danger" : "btn-outline-primary") w-100 mb-2">
                                            Mark as @GetStatusLabel(ns)
                                        </button>
                                    }
                                </form>
                            }

                            @* Delivered — explicit confirmation *@
                            @if (nextStatuses.Contains("Delivered"))
                            {
                                <form asp-controller="DeliveryDashboard" asp-action="ConfirmDelivered"
                                      asp-route-orderId="@a.OrderId" method="post"
                                      onsubmit="return confirm('Confirm this order was successfully delivered?');">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-2">
                                        <textarea name="StatusNotes" class="form-control form-control-sm" rows="2"
                                                  placeholder="Delivery notes (optional)"></textarea>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox"
                                               name="DeliveredConfirmed" value="true" id="confirmChk" required />
                                        <label class="form-check-label small" for="confirmChk">
                                            I confirm this order has been delivered to the customer.
                                        </label>
                                    </div>
                                    <button type="submit" class="btn btn-success w-100">
                                        ✓ Confirm Delivered
                                    </button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    static string GetStatusBadge(string status) => status switch {
        "Confirmed" or "Processing" => "bg-info text-dark",
        "PickedUp"       => "bg-primary",
        "OutForDelivery" => "bg-primary",
        "Delivered"      => "bg-success",
        "DeliveryFailed" => "bg-danger",
        _                => "bg-secondary"
    };
    static string GetStatusLabel(string status) => status switch {
        "OutForDelivery" => "Out for Delivery",
        "PickedUp"       => "Picked Up",
        "DeliveryFailed" => "Delivery Failed",
        _                => status
    };
    static List<string> GetNextStatuses(string status) => status switch {
        "Confirmed" or "Processing" => new() { "PickedUp" },
        "PickedUp"       => new() { "OutForDelivery", "DeliveryFailed" },
        "OutForDelivery" => new() { "Delivered", "DeliveryFailed" },
        _                => new()
    };
}
