@model GOLISMart.Web.Models.AccountOverviewViewModel
@{
    ViewData["Title"] = "My Account";
}

<div class="container py-4">
    <div class="row">
        @* Sidebar *@
        <div class="col-12 col-md-3 mb-4">
            <div class="list-group shadow-sm">
                <a asp-controller="Account" asp-action="Overview"
                   class="list-group-item list-group-item-action active fw-semibold">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                    My Account
                </a>
                <a asp-controller="Account" asp-action="EditProfile"
                   class="list-group-item list-group-item-action">
                    Edit Profile
                </a>
                <a asp-controller="Account" asp-action="ChangePassword"
                   class="list-group-item list-group-item-action">
                    Change Password
                </a>
                <a asp-controller="Account" asp-action="Addresses"
                   class="list-group-item list-group-item-action">
                    Saved Addresses
                </a>
            </div>
        </div>

        @* Content *@
        <div class="col-12 col-md-9">
            <h1 class="h4 fw-bold mb-4">My Account</h1>

            @if (TempData["SuccessMessage"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!Model.ApiAvailable)
            {
                <div class="alert alert-warning">
                    Unable to load your profile. Please try again later.
                </div>
            }
            else if (Model.Profile is null)
            {
                <div class="alert alert-secondary">Loading your account details…</div>
            }
            else
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3"
                                 style="width:56px;height:56px;font-size:1.5rem;font-weight:700;flex-shrink:0;">
                                @(string.IsNullOrEmpty(Model.Profile.DisplayName) ? "?" : Model.Profile.DisplayName[0].ToString().ToUpper())
                            </div>
                            <div>
                                <div class="fw-bold fs-5">@Model.Profile.DisplayName</div>
                                <div class="text-muted small">@Model.Profile.Email</div>
                            </div>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted small">Mobile</dt>
                            <dd class="col-sm-8">@(Model.Profile.PhoneNumber ?? "—")</dd>

                            <dt class="col-sm-4 text-muted small">Member since</dt>
                            <dd class="col-sm-8">@Model.Profile.CreatedAt.ToString("MMMM d, yyyy")</dd>
                        </dl>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex gap-2">
                        <a asp-controller="Account" asp-action="EditProfile" class="btn btn-outline-success btn-sm">
                            Edit Profile
                        </a>
                        <a asp-controller="Account" asp-action="Addresses" class="btn btn-outline-secondary btn-sm">
                            Manage Addresses
                        </a>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h6 class="card-title fw-semibold">Saved Addresses</h6>
                                <p class="card-text text-muted small">Manage your delivery addresses for faster checkout.</p>
                                <a asp-controller="Account" asp-action="Addresses" class="btn btn-sm btn-success">
                                    View Addresses
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h6 class="card-title fw-semibold">Account Security</h6>
                                <p class="card-text text-muted small">Update your password to keep your account secure.</p>
                                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-sm btn-outline-secondary">
                                    Change Password
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
