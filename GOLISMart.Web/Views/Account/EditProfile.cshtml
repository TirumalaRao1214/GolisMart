@model GOLISMart.Web.Models.EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12 col-md-3 mb-4">
            <div class="list-group shadow-sm">
                <a asp-controller="Account" asp-action="Overview" class="list-group-item list-group-item-action">My Account</a>
                <a asp-controller="Account" asp-action="EditProfile" class="list-group-item list-group-item-action active fw-semibold">Edit Profile</a>
                <a asp-controller="Account" asp-action="ChangePassword" class="list-group-item list-group-item-action">Change Password</a>
                <a asp-controller="Account" asp-action="Addresses" class="list-group-item list-group-item-action">Saved Addresses</a>
            </div>
        </div>

        <div class="col-12 col-md-9">
            <h1 class="h4 fw-bold mb-4">Edit Profile</h1>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="EditProfile" method="post" data-ajax-form="true" novalidate>
                        <div class="mb-3">
                            <label asp-for="DisplayName" class="form-label fw-semibold"></label>
                            <input asp-for="DisplayName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="DisplayName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Mobile" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">+91</span>
                                <input asp-for="Mobile" class="form-control" autocomplete="tel"
                                       type="tel" inputmode="numeric" maxlength="13" />
                            </div>
                            <span asp-validation-for="Mobile" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success px-4">Save Changes</button>
                            <a asp-controller="Account" asp-action="Overview" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
