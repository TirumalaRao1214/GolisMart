@model GOLISMart.Web.Models.AddressListViewModel
@{
    ViewData["Title"] = "Saved Addresses";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12 col-md-3 mb-4">
            <div class="list-group shadow-sm">
                <a asp-controller="Account" asp-action="Overview" class="list-group-item list-group-item-action">My Account</a>
                <a asp-controller="Account" asp-action="EditProfile" class="list-group-item list-group-item-action">Edit Profile</a>
                <a asp-controller="Account" asp-action="ChangePassword" class="list-group-item list-group-item-action">Change Password</a>
                <a asp-controller="Account" asp-action="Addresses" class="list-group-item list-group-item-action active fw-semibold">Saved Addresses</a>
            </div>
        </div>

        <div class="col-12 col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 fw-bold mb-0">Saved Addresses</h1>
                <a asp-controller="Account" asp-action="AddAddress" class="btn btn-success btn-sm">
                    + Add New Address
                </a>
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            @if (!Model.ApiAvailable)
            {
                <div class="alert alert-warning">Unable to load addresses. Please try again.</div>
            }
            else if (!Model.Addresses.Any())
            {
                <div class="text-center py-5">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#adb5bd" stroke-width="1.5" class="mb-3">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
                    </svg>
                    <h5 class="text-muted">No saved addresses</h5>
                    <p class="text-muted small">Add a delivery address to speed up checkout.</p>
                    <a asp-controller="Account" asp-action="AddAddress" class="btn btn-success">
                        Add Address
                    </a>
                </div>
            }
            else
            {
                <div class="row g-3" id="gm-address-list-row">
                    @foreach (var address in Model.Addresses)
                    {
                        @await Html.PartialAsync("_AddressCard", address)
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('form[data-confirm]').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (!confirm(form.dataset.confirm)) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
