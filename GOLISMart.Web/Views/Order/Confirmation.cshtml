@model GOLISMart.Web.Models.OrderConfirmationViewModel
@using GOLISMart.Web.Services
@{
    ViewData["Title"] = "Order Confirmed";
    var order = Model.Order;
}

<div class="container py-4">

    @if (!Model.ApiAvailable || order is null)
    {
        <div class="alert alert-warning" role="alert">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                @Model.ErrorMessage
            }
            else
            {
                <span>Unable to load order confirmation.</span>
            }
        </div>
        <div class="d-flex gap-3 flex-wrap">
            <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-primary">View My Orders</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Continue Shopping</a>
        </div>
    }
    else
    {
        @* Success banner *@
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success text-white mb-3"
                 style="width:64px;height:64px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                     style="width:30px;height:30px;">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>
            <h1 class="h4 fw-bold text-success">Order Placed Successfully!</h1>
            <p class="text-muted mb-0">
                Thank you for your order. Your order number is
                <strong style="color:var(--gm-primary);">@order.OrderNumber</strong>.
            </p>
        </div>

        <div class="row g-4">

            @* ── Left: Details ───────────────────────────────────────────────── *@
            <div class="col-12 col-lg-8">

                @* Order summary card *@
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Order Details</span>
                        <span class="badge @(order.Status == "Pending" ? "bg-warning text-dark" : "bg-success")">
                            @order.Status
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 small">
                            <div class="col-6 col-sm-4">
                                <div class="text-muted">Order Number</div>
                                <div class="fw-semibold">@order.OrderNumber</div>
                            </div>
                            <div class="col-6 col-sm-4">
                                <div class="text-muted">Order Date</div>
                                <div class="fw-semibold">@order.OrderDate.ToString("dd MMM yyyy, h:mm tt")</div>
                            </div>
                            <div class="col-6 col-sm-4">
                                <div class="text-muted">Payment</div>
                                <div class="fw-semibold">@order.PaymentMethod
                                    <span class="badge @(order.PaymentStatus == "Paid" ? "bg-success" : "bg-secondary") ms-1" style="font-size:.65rem;">
                                        @order.PaymentStatus
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Delivery address *@
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white fw-semibold">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             style="width:14px;height:14px;vertical-align:middle;margin-right:5px;">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        Delivery Address
                    </div>
                    <div class="card-body small">
                        <p class="mb-0">
                            @order.DeliveryAddress.AddressLine1
                            @if (!string.IsNullOrEmpty(order.DeliveryAddress.AddressLine2))
                            {
                                <br />@order.DeliveryAddress.AddressLine2
                            }
                            <br />@order.DeliveryAddress.City — @order.DeliveryAddress.PinCode,
                            @order.DeliveryAddress.State
                        </p>
                    </div>
                </div>

                @* Items *@
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white fw-semibold">
                        Items Ordered
                        <span class="text-muted fw-normal small ms-1">(@order.Items.Count item type@(order.Items.Count != 1 ? "s" : ""))</span>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var item in order.Items)
                        {
                            <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@item.ProductName</div>
                                    <div class="text-muted small">@item.UnitLabel · @item.ProductSKU</div>
                                </div>
                                <div class="text-center" style="min-width:60px;">
                                    <div class="small text-muted">Qty</div>
                                    <div class="fw-semibold small">@item.Quantity.ToString("G29")</div>
                                </div>
                                <div class="text-end" style="min-width:85px;">
                                    <div class="fw-semibold small">₹@item.LineTotal.ToString("N2")</div>
                                    @if (item.OfferPrice.HasValue && item.OfferPrice.Value < item.UnitPrice)
                                    {
                                        <div class="small text-decoration-line-through text-muted">₹@item.UnitPrice.ToString("N2")</div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">₹@item.EffectivePrice.ToString("N2") each</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ── Right: Totals ───────────────────────────────────────────────── *@
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top:80px;">
                    <div class="card-header bg-white fw-semibold">Order Total</div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Subtotal</span>
                            <span>₹@order.SubTotal.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Delivery</span>
                            @if (order.DeliveryFee == 0)
                            {
                                <span class="text-success fw-semibold">Free</span>
                            }
                            else
                            {
                                <span>₹@order.DeliveryFee.ToString("N2")</span>
                            }
                        </div>
                        @if (order.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Discount</span>
                                <span class="text-success">-₹@order.DiscountAmount.ToString("N2")</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between fw-bold mb-4">
                            <span>Total</span>
                            <span style="color:var(--gm-primary);">₹@order.TotalAmount.ToString("N2")</span>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="Order" asp-action="Detail"
                               asp-route-orderId="@order.OrderId"
                               class="btn btn-outline-primary">
                                View Order Details
                            </a>
                            <a asp-controller="Order" asp-action="MyOrders"
                               class="btn btn-outline-secondary">
                                My Orders
                            </a>
                            <a asp-controller="Home" asp-action="Index"
                               class="btn btn-success">
                                Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }

</div>
