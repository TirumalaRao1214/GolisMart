@model GOLISMart.Web.Models.OrderDetailViewModel
@using GOLISMart.Web.Services
@{
    ViewData["Title"] = Model.Order is null ? "Order Details" : $"Order {Model.Order.OrderNumber}";
    var order    = Model.Order;
    var tracking = Model.Tracking;
}

<div class="container py-4">

    @* Breadcrumb *@
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Order" asp-action="MyOrders">My Orders</a></li>
            <li class="breadcrumb-item active">@(order?.OrderNumber ?? "Order Details")</li>
        </ol>
    </nav>

    @* Flash messages *@
    @if (Model.SuccessMessage is string successMsg)
    {
        <div class="alert alert-success" role="alert">@successMsg</div>
    }
    @if (TempData["OrderError"] is string errMsg)
    {
        <div class="alert alert-danger" role="alert">@errMsg</div>
    }
    @if (TempData["CancelSuccess"] is string cancelMsg)
    {
        <div class="alert alert-success" role="alert">@cancelMsg</div>
    }

    @if (!Model.ApiAvailable || order is null)
    {
        <div class="alert alert-warning" role="alert">
            @(Model.ErrorMessage ?? "Unable to load order details. Please try again.")
        </div>
        <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-secondary">← My Orders</a>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h1 class="h4 fw-bold mb-0" style="color:var(--gm-text);">
                Order @order.OrderNumber
            </h1>
            <span class="badge fs-6 @GetStatusBadge(order.Status)">@GetStatusLabel(order.Status)</span>
        </div>

        <div class="row g-4">

            @* ── Left column ─────────────────────────────────────────────────── *@
            <div class="col-12 col-lg-8">

                @* Order info *@
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white fw-semibold">Order Information</div>
                    <div class="card-body">
                        <div class="row g-2 small">
                            <div class="col-6 col-sm-3">
                                <div class="text-muted">Order Date</div>
                                <div class="fw-semibold">@order.OrderDate.ToString("dd MMM yyyy")</div>
                                <div class="text-muted" style="font-size:.7rem;">@order.OrderDate.ToString("h:mm tt UTC")</div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="text-muted">Payment Method</div>
                                <div class="fw-semibold">@order.PaymentMethod</div>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="text-muted">Payment Status</div>
                                <span class="badge @GetPaymentBadge(order.PaymentStatus) text-dark">@order.PaymentStatus</span>
                            </div>
                            <div class="col-6 col-sm-3">
                                <div class="text-muted">Items</div>
                                <div class="fw-semibold">@order.Items.Count type@(order.Items.Count != 1 ? "s" : "")</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(order.Notes))
                        {
                            <div class="mt-2 small">
                                <span class="text-muted">Notes:</span> @order.Notes
                            </div>
                        }
                    </div>
                </div>

                @* Delivery address *@
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white fw-semibold">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             style="width:14px;height:14px;vertical-align:middle;margin-right:5px;">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        Delivery Address
                    </div>
                    <div class="card-body small">
                        <p class="mb-0">
                            @order.DeliveryAddress.AddressLine1
                            @if (!string.IsNullOrEmpty(order.DeliveryAddress.AddressLine2))
                            {
                                <br />@order.DeliveryAddress.AddressLine2
                            }
                            <br />@order.DeliveryAddress.City — @order.DeliveryAddress.PinCode,
                            @order.DeliveryAddress.State
                        </p>
                    </div>
                </div>

                @* Items *@
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white fw-semibold">Items in this Order</div>
                    <div class="card-body p-0">
                        @foreach (var item in order.Items)
                        {
                            <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@item.ProductName</div>
                                    <div class="text-muted small">@item.UnitLabel · @item.ProductSKU</div>
                                </div>
                                <div class="text-center" style="min-width:60px;">
                                    <div class="small text-muted">Qty</div>
                                    <div class="fw-semibold small">@item.Quantity.ToString("G29")</div>
                                </div>
                                <div class="text-end" style="min-width:85px;">
                                    <div class="fw-semibold small">₹@item.LineTotal.ToString("N2")</div>
                                    @if (item.OfferPrice.HasValue && item.OfferPrice.Value < item.UnitPrice)
                                    {
                                        <div class="small text-decoration-line-through text-muted">₹@item.UnitPrice.ToString("N2")</div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">₹@item.EffectivePrice.ToString("N2") each</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Delivery tracking timeline *@
                @if (tracking is not null)
                {
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-white fw-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 style="width:14px;height:14px;vertical-align:middle;margin-right:5px;">
                                <rect x="1" y="3" width="15" height="13"/>
                                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                            Delivery Tracking
                        </div>
                        <div class="card-body">
                            @if (tracking.AssignedPersonnelName is not null)
                            {
                                <div class="alert alert-info py-2 small mb-3">
                                    🚚 Delivery person: <strong>@tracking.AssignedPersonnelName</strong>
                                </div>
                            }
                            @* Visual timeline *@
                            <div style="position:relative;padding-left:28px;">
                                @{ var steps = new[] { ("Confirmed","Confirmed"), ("Processing","Processing"), ("PickedUp","Picked Up"), ("OutForDelivery","Out for Delivery"), ("Delivered","Delivered") }; }
                                @foreach (var (stepStatus, stepLabel) in steps)
                                {
                                    var reached = tracking.Timeline.Any(h => string.Equals(h.Status, stepStatus, StringComparison.OrdinalIgnoreCase));
                                    var histEntry = tracking.Timeline.FirstOrDefault(h => string.Equals(h.Status, stepStatus, StringComparison.OrdinalIgnoreCase));
                                    <div class="d-flex align-items-start gap-2 mb-3" style="position:relative;">
                                        <div style="position:absolute;left:-24px;top:3px;
                                             width:18px;height:18px;border-radius:50%;border:2px solid @(reached ? "#198754" : "#dee2e6");
                                             background:@(reached ? "#198754" : "#fff");flex-shrink:0;">
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="small fw-semibold @(reached ? "" : "text-muted")">@stepLabel</div>
                                            @if (histEntry is not null)
                                            {
                                                <div class="text-muted" style="font-size:.7rem;">
                                                    @histEntry.ChangedAt.ToString("dd MMM yyyy, h:mm tt") UTC
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                @* Failed state *@
                                @if (tracking.Timeline.Any(h => h.Status == "DeliveryFailed"))
                                {
                                    var failEntry = tracking.Timeline.Last(h => h.Status == "DeliveryFailed");
                                    <div class="alert alert-warning py-2 small">
                                        Delivery attempt failed on @failEntry.ChangedAt.ToString("dd MMM yyyy").
                                        @if (!string.IsNullOrEmpty(failEntry.Notes)) { <span>@failEntry.Notes</span> }
                                        We will contact you to reschedule.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @* Status history *@
                @if (order.StatusHistory?.Count > 0)
                {
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white fw-semibold">Order Status History</div>
                        <div class="card-body p-0">
                            @foreach (var h in order.StatusHistory)
                            {
                                <div class="d-flex align-items-start gap-3 p-3 border-bottom">
                                    <div class="mt-1">
                                        <span class="badge @GetStatusBadge(h.Status)">@GetStatusLabel(h.Status)</span>
                                    </div>
                                    <div class="flex-grow-1">
                                        @if (!string.IsNullOrEmpty(h.Notes))
                                        {
                                            <div class="small">@h.Notes</div>
                                        }
                                        <div class="text-muted" style="font-size:.72rem;">
                                            @h.ChangedAt.ToString("dd MMM yyyy, h:mm tt UTC")
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* ── Right column: totals + actions ──────────────────────────────── *@
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top:80px;">
                    <div class="card-header bg-white fw-semibold">Order Total</div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Subtotal</span>
                            <span>₹@order.SubTotal.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Delivery</span>
                            @if (order.DeliveryFee == 0)
                            {
                                <span class="text-success fw-semibold">Free</span>
                            }
                            else
                            {
                                <span>₹@order.DeliveryFee.ToString("N2")</span>
                            }
                        </div>
                        @if (order.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Discount</span>
                                <span class="text-success">-₹@order.DiscountAmount.ToString("N2")</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between fw-bold mb-4">
                            <span>Total</span>
                            <span style="color:var(--gm-primary);">₹@order.TotalAmount.ToString("N2")</span>
                        </div>

                        <div class="d-grid gap-2">
                            @if (order.CanCancel)
                            {
                                <form method="post"
                                      asp-controller="Order" asp-action="Cancel"
                                      asp-route-orderId="@order.OrderId"
                                      onsubmit="return confirm('Are you sure you want to cancel this order?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger w-100">
                                        Cancel Order
                                    </button>
                                </form>
                            }
                            <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-secondary">
                                ← My Orders
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                                Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@functions {
    static string GetStatusBadge(string status) => status switch {
        "Pending"         => "bg-warning text-dark",
        "Confirmed"       => "bg-info text-dark",
        "Processing"      => "bg-primary",
        "OutForDelivery"  => "bg-primary",
        "Delivered"       => "bg-success",
        "Cancelled"       => "bg-secondary",
        "Refunded"        => "bg-secondary",
        _                 => "bg-light text-dark"
    };

    static string GetStatusLabel(string status) => status switch {
        "OutForDelivery" => "Out for Delivery",
        "Processing"     => "Processing",
        "PickedUp"       => "Picked Up",
        "DeliveryFailed" => "Delivery Failed",
        _                => status
    };

    static string GetPaymentBadge(string paymentStatus) => paymentStatus switch {
        "Paid"     => "bg-success-subtle",
        "Failed"   => "bg-danger-subtle",
        "Refunded" => "bg-secondary-subtle",
        _          => "bg-light"
    };
}
