@model GOLISMart.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Fresh Groceries Delivered";
}

@if (!Model.ApiAvailable)
{
    @await Html.PartialAsync("_ApiError")
}
else
{
    @* ── Hero ──────────────────────────────────────────────────────────── *@
    <section class="gm-hero">
        <div class="container">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="gm-hero-eyebrow">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        Fresh &amp; Fast Delivery
                    </div>
                    <h1 class="gm-hero-headline">
                        Fresh groceries,<br/>
                        <span>delivered to your</span><br/>
                        doorstep
                    </h1>
                    <p class="gm-hero-sub">
                        Farm-fresh vegetables, fruits, dairy, pulses and everyday pantry staples — sourced fresh and delivered fast.
                    </p>
                    <div class="gm-hero-ctas">
                        <a asp-controller="Catalog" asp-action="Index" class="gm-btn-primary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 001.97 1.61h9.72a2 2 0 001.97-1.61L23 6H6"/>
                            </svg>
                            Shop Groceries
                        </a>
                        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="fresh-vegetables" class="gm-btn-secondary">
                            Browse Fresh Produce
                        </a>
                    </div>
                    <div class="gm-pincode-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
                        </svg>
                        <label for="heroPincode">Check delivery:</label>
                        <input class="gm-pincode-input" type="text" id="heroPincode" maxlength="6" inputmode="numeric"
                               placeholder="Enter pincode" aria-label="Enter pincode to check delivery" />
                        <button class="gm-pincode-btn" type="button" id="heroPincodeBtn"
                                onclick="if(window.GMDelivery){window.GMDelivery.checkPincode(document.getElementById('heroPincode').value, 'pincodeMsg');}">
                            Check
                        </button>
                        <div id="pincodeMsg" class="mt-2 w-100" style="display:none;"></div>
                    </div>
                    @* Stats strip *@
                    <div class="gm-hero-stats mt-4">
                        <div class="gm-hero-stat">
                            <div class="gm-hero-stat-value">500+</div>
                            <div class="gm-hero-stat-label">Products</div>
                        </div>
                        <div class="gm-hero-stat">
                            <div class="gm-hero-stat-value">2 hr</div>
                            <div class="gm-hero-stat-label">Delivery</div>
                        </div>
                        <div class="gm-hero-stat">
                            <div class="gm-hero-stat-value">10k+</div>
                            <div class="gm-hero-stat-label">Happy customers</div>
                        </div>
                        <div class="gm-hero-stat">
                            <div class="gm-hero-stat-value">100%</div>
                            <div class="gm-hero-stat-label">Fresh quality</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="gm-hero-img-wrap">
                        <img src="/images/hero/hero-produce.jpg"
                             alt="Fresh fruits and vegetables in a grocery basket"
                             class="gm-hero-img"
                             width="600" height="480" />
                        @* Floating badge *@
                        <div class="gm-hero-badge">
                            <div class="gm-hero-badge-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                            </div>
                            <div>
                                <div class="gm-hero-badge-value">Farm to table</div>
                                <div class="gm-hero-badge-text">Freshness guaranteed</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── Trust / USP strip ──────────────────────────────────────────────── *@
    <div class="gm-trust-strip">
        <div class="container">
            <div class="row row-cols-2 row-cols-md-4 g-2 g-md-0">
                <div class="col">
                    <div class="gm-trust-item">
                        <div class="gm-trust-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                        </div>
                        <div>
                            <div class="gm-trust-title">Fast Delivery</div>
                            <div class="gm-trust-desc">2-hour delivery window</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="gm-trust-item">
                        <div class="gm-trust-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="gm-trust-title">Quality Assured</div>
                            <div class="gm-trust-desc">Freshness guaranteed</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="gm-trust-item">
                        <div class="gm-trust-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                            </svg>
                        </div>
                        <div>
                            <div class="gm-trust-title">Best Prices</div>
                            <div class="gm-trust-desc">Competitive daily rates</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="gm-trust-item">
                        <div class="gm-trust-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
                                <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                            </svg>
                        </div>
                        <div>
                            <div class="gm-trust-title">Easy Returns</div>
                            <div class="gm-trust-desc">Hassle-free policy</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Shop by Category ───────────────────────────────────────────────── *@
    <section class="gm-section">
        <div class="container">
            <div class="gm-section-head">
                <h2 class="gm-section-title">
                    <span class="gm-section-title-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    </span>
                    Shop by Category
                </h2>
                <a asp-controller="Catalog" asp-action="Index" class="gm-section-link">
                    All categories
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            </div>
            @if (Model.Categories.Count == 0)
            {
                <div class="gm-empty-state">
                    <div class="gm-empty-state-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    </div>
                    <h5>No categories available</h5>
                    <p>Please check back soon.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
                    @foreach (var cat in Model.Categories)
                    {
                        <div class="col">
                            @await Html.PartialAsync("_CategoryCard", cat)
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    @* ── Featured Products ──────────────────────────────────────────────── *@
    @if (Model.FeaturedProducts.Count > 0)
    {
        <section class="gm-section" style="padding-top:0">
            <div class="container">
                <div class="gm-section-head">
                    <h2 class="gm-section-title">
                        <span class="gm-section-title-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        </span>
                        Today's Featured
                    </h2>
                    <a asp-controller="Catalog" asp-action="Index" class="gm-section-link">
                        View all
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-5 g-3">
                    @foreach (var p in Model.FeaturedProducts)
                    {
                        <div class="col">
                            @await Html.PartialAsync("_ProductCard", p)
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @* ── Fresh Vegetables ───────────────────────────────────────────────── *@
    @if (Model.FreshVegetables.Count > 0)
    {
        <section class="gm-section" style="padding-top:0">
            <div class="container">
                <div class="gm-section-head">
                    <h2 class="gm-section-title">
                        <span class="gm-section-title-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 01-6.88 9.5M12 22V12"/></svg>
                        </span>
                        Fresh Vegetables
                    </h2>
                    <a asp-controller="Catalog" asp-action="Category" asp-route-slug="fresh-vegetables" class="gm-section-link">
                        See all
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-5 g-3">
                    @foreach (var p in Model.FreshVegetables)
                    {
                        <div class="col">
                            @await Html.PartialAsync("_ProductCard", p)
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @* ── Fresh Fruits ───────────────────────────────────────────────────── *@
    @if (Model.FreshFruits.Count > 0)
    {
        <section class="gm-section" style="padding-top:0">
            <div class="container">
                <div class="gm-section-head">
                    <h2 class="gm-section-title">
                        <span class="gm-section-title-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="14" r="8"/><path d="M12 6V2"/></svg>
                        </span>
                        Fresh Fruits
                    </h2>
                    <a asp-controller="Catalog" asp-action="Category" asp-route-slug="fresh-fruits" class="gm-section-link">
                        See all
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-5 g-3">
                    @foreach (var p in Model.FreshFruits)
                    {
                        <div class="col">
                            @await Html.PartialAsync("_ProductCard", p)
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @* ── Everyday Groceries (Daily Essentials) ──────────────────────────── *@
    @if (Model.DailyEssentials.Count > 0)
    {
        <section class="gm-section" style="padding-top:0">
            <div class="container">
                <div class="gm-section-head">
                    <h2 class="gm-section-title">
                        <span class="gm-section-title-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                        </span>
                        Everyday Groceries
                    </h2>
                    <a asp-controller="Catalog" asp-action="Category" asp-route-slug="dairy-and-eggs" class="gm-section-link">
                        See all
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-5 g-3">
                    @foreach (var p in Model.DailyEssentials)
                    {
                        <div class="col">
                            @await Html.PartialAsync("_ProductCard", p)
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @* ── Special Offers Banner ──────────────────────────────────────────── *@
    <section class="gm-section" style="padding-top:0">
        <div class="container">
            <div class="gm-promo-banner">
                <div class="row align-items-center g-3">
                    <div class="col-12 col-md-8">
                        <div class="gm-promo-code">GOLIS50</div>
                        <h3>₹50 off your first order</h3>
                        <p>Use code <strong>GOLIS50</strong> at checkout. Valid on orders above ₹500. Fresh produce, dairy, and pantry staples.</p>
                        <a asp-controller="Catalog" asp-action="Index" class="gm-btn-white">
                            Shop Now
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                    </div>
                    <div class="col-12 col-md-4 text-center d-none d-md-block">
                        <img src="/images/hero/hero-groceries.jpg"
                             alt="Fresh groceries"
                             style="width:100%;max-width:200px;border-radius:12px;opacity:.85"
                             loading="lazy"
                             onerror="this.style.display='none'" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── Why GOLIS Mart ─────────────────────────────────────────────────── *@
    <section class="gm-section" style="padding-top:0">
        <div class="container">
            <div class="gm-section-head">
                <h2 class="gm-section-title">
                    <span class="gm-section-title-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </span>
                    Why Shop with GOLIS Mart?
                </h2>
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="p-4 border rounded-3 h-100" style="border-color:var(--gm-border)!important;">
                        <div class="gm-trust-icon mb-3" style="width:48px;height:48px;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <h6 class="fw-bold mb-2">Farm-Fresh Quality</h6>
                        <p class="text-muted mb-0" style="font-size:.85rem;">We source directly from local farms and trusted suppliers. Every item is handpicked for freshness and quality.</p>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="p-4 border rounded-3 h-100" style="border-color:var(--gm-border)!important;">
                        <div class="gm-trust-icon mb-3" style="width:48px;height:48px;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        </div>
                        <h6 class="fw-bold mb-2">2-Hour Express Delivery</h6>
                        <p class="text-muted mb-0" style="font-size:.85rem;">Order before noon and get your groceries by 2 PM. Choose a delivery slot that works for your schedule.</p>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="p-4 border rounded-3 h-100" style="border-color:var(--gm-border)!important;">
                        <div class="gm-trust-icon mb-3" style="width:48px;height:48px;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
                        </div>
                        <h6 class="fw-bold mb-2">Easy Returns</h6>
                        <p class="text-muted mb-0" style="font-size:.85rem;">Not satisfied? We'll replace or refund within 24 hours. No questions asked, no hassle, ever.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── Delivery Info ─────────────────────────────────────────────────── *@
    <section class="gm-section" style="padding-top:0">
        <div class="container">
            <div class="gm-delivery-section">
                <div class="row g-4 align-items-center">
                    <div class="col-12 col-md-5">
                        <h3 class="fw-bold mb-2" style="font-size:1.3rem;">How delivery works</h3>
                        <p class="text-muted mb-0" style="font-size:.88rem;">
                            Get fresh groceries at your door in three simple steps. We deliver across selected pincodes in your city.
                        </p>
                    </div>
                    <div class="col-12 col-md-7">
                        <div class="d-flex flex-column gap-3">
                            <div class="gm-delivery-step">
                                <div class="gm-delivery-num">1</div>
                                <div>
                                    <div class="gm-delivery-step-title">Browse &amp; Add to Cart</div>
                                    <div class="gm-delivery-step-desc">Choose from 500+ fresh products across 10 categories.</div>
                                </div>
                            </div>
                            <div class="gm-delivery-step">
                                <div class="gm-delivery-num">2</div>
                                <div>
                                    <div class="gm-delivery-step-title">Pick a Delivery Slot</div>
                                    <div class="gm-delivery-step-desc">Select a 2-hour window that suits your day.</div>
                                </div>
                            </div>
                            <div class="gm-delivery-step">
                                <div class="gm-delivery-num">3</div>
                                <div>
                                    <div class="gm-delivery-step-title">Receive at Your Door</div>
                                    <div class="gm-delivery-step-desc">Our delivery partner brings groceries straight to you.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
