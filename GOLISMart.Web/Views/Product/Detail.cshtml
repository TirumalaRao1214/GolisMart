@model GOLISMart.Web.Models.ProductDetailViewModel
@{
    var p = Model.Product;
    ViewData["Title"] = p?.Name ?? (Model.NotFound ? "Product Not Found" : "Product");
    var displayPrice = p?.OfferPrice ?? p?.Price ?? 0;
    var discountPct  = (p?.OfferPrice.HasValue == true && p.Price > 0)
        ? (int)Math.Round((p.Price - p.OfferPrice!.Value) / p.Price * 100)
        : 0;
}

@if (!Model.ApiAvailable)
{
    @await Html.PartialAsync("_ApiError")
}
else if (Model.NotFound || p is null)
{
    <div class="container py-5 text-center">
        <div class="gm-empty-state">
            <div class="gm-empty-state-icon" style="width:80px;height:80px;margin-bottom:20px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <h2 class="h4 fw-bold" style="color:var(--gm-text);">Product Not Found</h2>
            <p style="color:var(--gm-text-muted);">This product may have been removed or the link is incorrect.</p>
            <a asp-controller="Catalog" asp-action="Index" class="gm-btn-primary mt-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Browse All Products
            </a>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        @* Breadcrumb *@
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                @if (!string.IsNullOrEmpty(p.CategorySlug))
                {
                    <li class="breadcrumb-item">
                        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="@p.CategorySlug">@p.CategoryName</a>
                    </li>
                }
                <li class="breadcrumb-item active" aria-current="page">@p.Name</li>
            </ol>
        </nav>

        <div class="row g-5">
            @* ── Product image ───────────────────────────────────────────── *@
            <div class="col-12 col-md-5">
                @{
                    var primaryImg = p.Images.FirstOrDefault(i => i.IsPrimary) ?? p.Images.FirstOrDefault();
                    var imgSrc = primaryImg?.ImagePath ?? p.ImagePath;
                }
                <div class="gm-detail-img-wrap">
                    @if (!string.IsNullOrEmpty(imgSrc))
                    {
                        <img src="@imgSrc" alt="@p.Name"
                             onerror="this.onerror=null;this.src='/images/products/placeholder.svg'" />
                    }
                    else
                    {
                        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--gm-neutral-100);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="color:var(--gm-neutral-400);"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        </div>
                    }
                </div>
                @* Thumbnail strip *@
                @if (p.Images.Count > 1)
                {
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        @foreach (var img in p.Images.Take(5))
                        {
                            <div class="gm-detail-thumb">
                                <img src="@img.ImagePath" alt="@(img.AltText ?? p.Name)"
                                     onerror="this.parentElement.style.display='none'" />
                            </div>
                        }
                    </div>
                }
            </div>

            @* ── Product info ────────────────────────────────────────────── *@
            <div class="col-12 col-md-7">
                <a asp-controller="Catalog" asp-action="Category" asp-route-slug="@p.CategorySlug"
                   style="font-size:.8rem;color:var(--gm-primary);text-decoration:none;font-weight:600;text-transform:uppercase;letter-spacing:.4px;">
                    @p.CategoryName
                </a>
                <h1 class="h3 fw-bold mt-2 mb-1" style="color:var(--gm-text);">@p.Name</h1>
                <p style="font-size:.82rem;color:var(--gm-text-muted);margin-bottom:16px;">
                    SKU: @p.SKU &nbsp;&bull;&nbsp; Per @p.UnitLabel
                </p>

                @* Stock status chip *@
                @if (!p.IsInStock)
                {
                    <span class="gm-stock-chip gm-chip-outstock mb-3 d-inline-flex">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        Out of stock
                    </span>
                }
                else if (p.IsLowStock)
                {
                    <span class="gm-stock-chip gm-chip-lowstock mb-3 d-inline-flex">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        Only a few left!
                    </span>
                }
                else
                {
                    <span class="gm-stock-chip gm-chip-instock mb-3 d-inline-flex">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        In stock
                    </span>
                }

                @* Pricing *@
                <div class="mt-2 mb-4" style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;">
                    <span class="gm-detail-price">&#8377;@displayPrice.ToString("N2")</span>
                    @if (p.OfferPrice.HasValue)
                    {
                        <span class="gm-detail-original">&#8377;@p.Price.ToString("N2")</span>
                        <span class="gm-product-off">@discountPct% off</span>
                    }
                </div>

                @* Description *@
                @if (!string.IsNullOrEmpty(p.Description))
                {
                    <p style="color:var(--gm-text);line-height:1.7;margin-bottom:24px;">@p.Description</p>
                }

                @* Quantity + Add to cart *@
                @if (p.IsInStock)
                {
                    <form method="post" asp-controller="Cart" asp-action="Add"
                          style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@p.Id" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <div class="gm-qty-row">
                            <button class="gm-qty-btn" type="button"
                                    onclick="adjustDetailQty(this,-1)"
                                    aria-label="Decrease quantity">−</button>
                            <input type="number" name="quantity" id="detailQty"
                                   class="gm-qty-val"
                                   value="1" min="1" max="@(p.AvailableQuantity > 20 ? 20 : (int)p.AvailableQuantity)"
                                   step="1" aria-live="polite" style="width:48px;text-align:center;border:none;background:transparent;font-size:1rem;font-weight:600;" />
                            <button class="gm-qty-btn" type="button"
                                    onclick="adjustDetailQty(this,1)"
                                    aria-label="Increase quantity">+</button>
                        </div>
                        <button type="submit" class="gm-add-to-cart-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                            Add to Cart
                        </button>
                    </form>
                }
                else
                {
                    <button class="gm-add-to-cart-btn" disabled style="background:var(--gm-neutral-200);color:var(--gm-neutral-400);margin-bottom:16px;">
                        Currently Unavailable
                    </button>
                }

                @* Promise strip *@
                <div class="gm-detail-promise">
                    <div class="gm-detail-promise-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        Fresh quality guaranteed
                    </div>
                    <div class="gm-detail-promise-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        Fast delivery
                    </div>
                    <div class="gm-detail-promise-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.15"/></svg>
                        Easy returns
                    </div>
                </div>
            </div>
        </div>

        @* Related products *@
        @if (Model.RelatedProducts.Count > 0)
        {
            <div class="gm-section">
                <div class="gm-section-head">
                    <h2 class="gm-section-title">
                        <div class="gm-section-title-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        </div>
                        You Might Also Like
                    </h2>
                    <a asp-controller="Catalog" asp-action="Category" asp-route-slug="@p.CategorySlug"
                       class="gm-section-link">
                        See all
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3">
                    @foreach (var rp in Model.RelatedProducts)
                    {
                        <div class="col">
                            @await Html.PartialAsync("_ProductCard", rp)
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
