@model GOLISMart.Web.Models.CheckoutReviewViewModel
@using GOLISMart.Web.Services
@{
    ViewData["Title"] = "Checkout — Review Order";
    var summary = Model.Summary;
}

<div class="container py-4">

    @* Checkout breadcrumb *@
    <nav aria-label="Checkout steps" class="mb-4">
        <ol class="checkout-steps">
            <li class="checkout-step checkout-step--done">
                <span class="checkout-step-num">✓</span>
                <span class="checkout-step-label">Delivery Address</span>
            </li>
            <li class="checkout-step checkout-step--active">
                <span class="checkout-step-num">2</span>
                <span class="checkout-step-label">Review Order</span>
            </li>
            <li class="checkout-step">
                <span class="checkout-step-num">3</span>
                <span class="checkout-step-label">Place Order</span>
            </li>
        </ol>
    </nav>

    <h1 class="h4 fw-bold mb-4" style="color:var(--gm-text);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             style="width:22px;height:22px;vertical-align:middle;margin-right:8px;">
            <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
        </svg>
        Review Your Order
    </h1>

    @* Flash messages *@
    @if (TempData["CheckoutInfo"] is string infoMsg)
    {
        <div class="alert alert-info" role="alert">@infoMsg</div>
    }
    @if (TempData["CheckoutError"] is string errMsg)
    {
        <div class="alert alert-danger" role="alert">@errMsg</div>
    }

    @if (!Model.ApiAvailable || summary is null)
    {
        @if (Model.ValidationIssues.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Please resolve the following issues before continuing:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var issue in Model.ValidationIssues)
                    {
                        <li>@issue</li>
                    }
                </ul>
            </div>
            <div class="d-flex gap-3 mt-3">
                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">← Update Cart</a>
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-outline-primary">← Change Address</a>
            </div>
        }
        else
        {
            <div class="alert alert-warning d-flex align-items-start gap-3" role="alert">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     style="width:20px;height:20px;flex-shrink:0;margin-top:2px;">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div>
                    <strong>Unable to load order review.</strong>
                    <div class="mt-1">
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            @Model.ErrorMessage
                        }
                        else
                        {
                            <span>The order review could not be completed. Please try again.</span>
                        }
                    </div>
                </div>
            </div>
            <div class="d-flex gap-3 flex-wrap mt-3">
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-outline-secondary">
                    ← Back to Address Selection
                </a>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">
                    ← View Cart
                </a>
            </div>
        }
    }
    else
    {
        <div class="row g-4">

            @* ── Main review panel ───────────────────────────────────────── *@
            <div class="col-12 col-lg-8">

                @* Delivery address card *@
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 style="width:15px;height:15px;vertical-align:middle;margin-right:5px;">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                            Delivering to
                        </span>
                        <a asp-controller="Checkout" asp-action="Index"
                           class="btn btn-sm btn-outline-secondary">Change</a>
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-2 align-items-center mb-1">
                            <span class="badge @(summary.Address.AddressLabel == "Home" ? "bg-success" : summary.Address.AddressLabel == "Work" ? "bg-primary" : "bg-secondary")">
                                @summary.Address.AddressLabel
                            </span>
                            @if (summary.Address.IsDefault)
                            {
                                <span class="badge bg-outline-success border border-success text-success small">Default</span>
                            }
                            <strong>@summary.Address.RecipientName</strong>
                            <span class="text-muted small">@summary.Address.RecipientMobile</span>
                        </div>
                        <p class="mb-0 small">
                            @summary.Address.HouseNumber, @summary.Address.BuildingStreet,<br />
                            @summary.Address.Locality,
                            @if (!string.IsNullOrEmpty(summary.Address.Landmark))
                            {
                                <span>near @summary.Address.Landmark,</span>
                            }
                            <br />@summary.Address.City — @summary.Address.PinCode, @summary.Address.State
                        </p>
                        @if (!string.IsNullOrEmpty(summary.Address.DeliveryInstructions))
                        {
                            <p class="mb-0 small text-muted mt-1">
                                <em>@summary.Address.DeliveryInstructions</em>
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(summary.EstimatedDeliveryWindow))
                        {
                            <div class="mt-2">
                                <span class="badge bg-light text-dark border small">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         style="width:12px;height:12px;vertical-align:middle;margin-right:3px;">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                    Estimated: @summary.EstimatedDeliveryWindow
                                </span>
                            </div>
                        }
                    </div>
                </div>

                @* Items list *@
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white fw-semibold">
                        Items in your order
                        <span class="text-muted fw-normal small ms-1">(@summary.Items.Count item type@(summary.Items.Count != 1 ? "s" : ""))</span>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var item in summary.Items)
                        {
                            <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.Name"
                                         style="width:56px;height:56px;object-fit:cover;border-radius:6px;flex-shrink:0;"
                                         onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <div style="width:56px;height:56px;background:#f1f5f9;border-radius:6px;flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="#adb5bd" stroke-width="1.5" width="24" height="24">
                                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                                            <circle cx="8.5" cy="8.5" r="1.5"/>
                                            <polyline points="21 15 16 10 5 21"/>
                                        </svg>
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@item.Name</div>
                                    <div class="text-muted small">@item.UnitLabel</div>
                                </div>
                                <div class="text-center" style="min-width:60px;">
                                    <div class="small text-muted">Qty</div>
                                    <div class="fw-semibold small">@item.Quantity.ToString("G29")</div>
                                </div>
                                <div class="text-end" style="min-width:80px;">
                                    <div class="fw-semibold small">₹@item.LineTotal.ToString("N2")</div>
                                    @if (item.OriginalPrice > item.UnitPrice)
                                    {
                                        <div class="small text-muted text-decoration-line-through">
                                            ₹@item.OriginalPrice.ToString("N2")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">₹@item.UnitPrice.ToString("N2") each</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Navigation buttons *@
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-outline-secondary">
                        ← Change Address
                    </a>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">
                        ← Edit Cart
                    </a>
                </div>
            </div>

            @* ── Order total sidebar ─────────────────────────────────────── *@
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top:80px;">
                    <div class="card-header bg-white fw-semibold">Order Total</div>
                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Subtotal (@summary.Items.Sum(i => (int)Math.Ceiling((double)i.Quantity)) items)</span>
                            <span class="small">₹@summary.SubTotal.ToString("N2")</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Delivery</span>
                            @if (summary.IsFreeDelivery)
                            {
                                <span class="small text-success fw-semibold">Free</span>
                            }
                            else
                            {
                                <span class="small">₹@summary.DeliveryFee.ToString("N2")</span>
                            }
                        </div>

                        @if (!summary.IsFreeDelivery && summary.FreeDeliveryAbove.HasValue)
                        {
                            var remaining = summary.FreeDeliveryAbove.Value - summary.SubTotal;
                            if (remaining > 0)
                            {
                                <div class="alert alert-light border small py-2 px-3 mb-2">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         style="width:12px;height:12px;vertical-align:middle;margin-right:3px;">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                    Add ₹@remaining.ToString("N2") more for free delivery
                                </div>
                            }
                        }

                        @if (summary.MinOrderValue.HasValue)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Min. order</span>
                                <span class="small @(summary.MeetsMinOrder ? "text-success" : "text-danger")">
                                    ₹@summary.MinOrderValue.Value.ToString("N2")
                                    @(summary.MeetsMinOrder ? "✓" : "✗")
                                </span>
                            </div>
                        }

                        <hr />

                        <div class="d-flex justify-content-between fw-bold mb-3">
                            <span>Total</span>
                            <span style="color:var(--gm-primary);">₹@summary.FinalTotal.ToString("N2")</span>
                        </div>

                        @if (!string.IsNullOrEmpty(summary.EstimatedDeliveryWindow))
                        {
                            <div class="text-muted small mb-3">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     style="width:13px;height:13px;vertical-align:middle;margin-right:3px;">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12 6 12 12 16 14"/>
                                </svg>
                                Estimated delivery: <strong>@summary.EstimatedDeliveryWindow</strong>
                            </div>
                        }

                        @* Payment method *@
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-2">Payment Method</label>
                            <div class="d-flex flex-column gap-2" id="paymentMethods">
                                <label class="d-flex align-items-center gap-2 p-2 border rounded" style="cursor:pointer;" id="codLabel">
                                    <input type="radio" name="paymentMethodSelect" id="pmCod" value="COD" checked />
                                    <span>
                                        <span class="fw-semibold">Cash on Delivery</span><br />
                                        <small class="text-muted">Pay when your order arrives.</small>
                                    </span>
                                </label>
                                <label class="d-flex align-items-center gap-2 p-2 border rounded" style="cursor:pointer;" id="onlineLabel">
                                    <input type="radio" name="paymentMethodSelect" id="pmOnline" value="Online" />
                                    <span>
                                        <span class="fw-semibold">Pay Online</span><br />
                                        <small class="text-muted">UPI, Card, NetBanking, Wallet via Razorpay.</small>
                                    </span>
                                </label>
                            </div>
                        </div>

                        @* COD confirm form *@
                        <form method="post" asp-controller="Checkout" asp-action="Confirm"
                              id="confirmForm" style="display:none;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="addressId" value="@summary.Address.AddressId" />
                            <input type="hidden" name="paymentMethod" value="COD" />
                            <button type="submit" class="btn btn-success w-100 fw-semibold" id="placeOrderBtn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     style="width:15px;height:15px;vertical-align:middle;margin-right:5px;">
                                    <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
                                </svg>
                                Place Order (COD)
                            </button>
                        </form>

                        @* Online payment button (Razorpay) *@
                        <div id="rzpPaySection" style="display:none;">
                            <button type="button" class="btn btn-success w-100 fw-semibold" id="rzpPayBtn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     style="width:15px;height:15px;vertical-align:middle;margin-right:5px;">
                                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                                    <line x1="1" y1="10" x2="23" y2="10"/>
                                </svg>
                                Pay ₹@summary.FinalTotal.ToString("N2") Online
                            </button>
                        </div>

                        @* Single always-visible primary action button *@
                        <div id="primaryActionSection">
                            <button type="button" class="btn btn-success w-100 fw-semibold" id="primaryBtn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     style="width:15px;height:15px;vertical-align:middle;margin-right:5px;">
                                    <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
                                </svg>
                                Place Order (COD)
                            </button>
                        </div>

                        @* Alert area for payment errors *@
                        <div id="paymentError" class="alert alert-danger mt-2 d-none" role="alert"></div>
                        <div id="paymentSuccess" class="alert alert-success mt-2 d-none" role="alert"></div>

                        <p class="text-muted text-center mt-2" style="font-size:.72rem;">
                            Prices and availability will be verified before your order is placed.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@section Scripts {
<script src="https://checkout.razorpay.com/v1/checkout.js" defer></script>
<script>
(function () {
    'use strict';

    var isSubmitting = false;

    // ── Antiforgery token (server-rendered into the COD form) ─────────────────
    // The MVC proxy endpoints require [ValidateAntiForgeryToken].
    // We read the token from the hidden field that @Html.AntiForgeryToken() emits
    // inside #confirmForm.  This is safe: the token is not a secret and must be
    // readable by JS to be sent in AJAX requests.
    function getAntiforgeryToken() {
        var el = document.querySelector('#confirmForm input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    // ── Helpers: show/hide error/success banners ──────────────────────────────
    function showError(msg, redirectUrl) {
        var el = document.getElementById('paymentError');
        if (!el) return;
        var html = escapeHtml(msg);
        if (redirectUrl) {
            html += ' <a href="' + escapeHtml(redirectUrl) + '" class="alert-link">Click here to continue.</a>';
        }
        el.innerHTML = html;
        el.classList.remove('d-none');
        document.getElementById('paymentSuccess').classList.add('d-none');
    }

    function showSuccess(msg) {
        var el = document.getElementById('paymentSuccess');
        if (!el) return;
        el.textContent = msg;
        el.classList.remove('d-none');
        document.getElementById('paymentError').classList.add('d-none');
    }

    function clearAlerts() {
        var errEl = document.getElementById('paymentError');
        var sucEl = document.getElementById('paymentSuccess');
        if (errEl) errEl.classList.add('d-none');
        if (sucEl) sucEl.classList.add('d-none');
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    // ── Toggle between COD and Online views ───────────────────────────────────
    // NOTE: updatePaymentUI() is called both on radio change AND from error/cancel
    // recovery paths (after isSubmitting has already been reset to false and the
    // button re-enabled).  We must NOT reset isSubmitting here — that is the
    // caller's responsibility.  We also must not re-enable or re-disable the button
    // unconditionally, so we only touch innerHTML when the button is not disabled.
    function updatePaymentUI() {
        var isCod       = document.getElementById('pmCod') && document.getElementById('pmCod').checked;
        var primaryBtn  = document.getElementById('primaryBtn');
        var confirmForm = document.getElementById('confirmForm');

        clearAlerts();

        // Only update the button label and handler when not mid-flight.
        // (If it IS disabled the spinner label is already set correctly.)
        if (primaryBtn.disabled) return;

        if (isCod) {
            var svgCod = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;vertical-align:middle;margin-right:5px;"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>';
            primaryBtn.innerHTML = svgCod + ' Place Order (COD)';
            primaryBtn.onclick = function () {
                if (isSubmitting) return;
                isSubmitting = true;
                primaryBtn.disabled = true;
                primaryBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Placing order…';
                confirmForm.submit();
            };
        } else {
            var svgOnline = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;vertical-align:middle;margin-right:5px;"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>';
            primaryBtn.innerHTML = svgOnline + ' Pay Online via Razorpay';
            primaryBtn.onclick = initiateRazorpayPayment;
        }
    }

    document.querySelectorAll('input[name="paymentMethodSelect"]').forEach(function (radio) {
        radio.addEventListener('change', updatePaymentUI);
    });

    updatePaymentUI();

    // ── Step 1: POST to MVC proxy — MVC reads session key + JWT server-side ───
    // The browser sends only the antiforgery token.  The session key and JWT
    // are never exposed to JavaScript.
    function initiateRazorpayPayment() {
        if (isSubmitting) return;

        if (!window.Razorpay) {
            showError('Payment gateway script failed to load. Please refresh the page and try again.');
            return;
        }

        var aft = getAntiforgeryToken();
        if (!aft) {
            // Page may have been loaded stale (e.g. back button after logout).
            showError('Page security token is missing. Please refresh the page and try again.', window.location.href);
            return;
        }

        isSubmitting = true;
        clearAlerts();

        var primaryBtn = document.getElementById('primaryBtn');
        primaryBtn.disabled = true;
        primaryBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Preparing payment…';

        // Idempotency key: one per checkout page load, kept in sessionStorage so
        // a retry re-uses the same key and the server returns the existing order.
        var idempotencyKey = sessionStorage.getItem('gm_rzp_idem') || generateUuid();
        sessionStorage.setItem('gm_rzp_idem', idempotencyKey);

        fetch('/checkout/razorpay/create-order', {
            method: 'POST',
            credentials: 'same-origin',          // sends session + auth cookies
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': aft   // antiforgery header
            },
            body: JSON.stringify({ idempotencyKey: idempotencyKey })
        })
        .then(function (res) {
            return res.text().then(function (text) {
                var data;
                try {
                    data = JSON.parse(text);
                } catch (e) {
                    data = null;
                }

                if (res.status === 401) {
                    var redirectUrl = (data && data.redirectUrl) || '/account/login?returnUrl=/checkout';
                    throw { message: (data && data.message) || 'Your login session has expired. Please log in again.', redirectUrl: redirectUrl, isAuth: true };
                }
                if (res.status === 400) {
                    var redir = (data && data.redirectUrl) || null;
                    throw { message: (data && (data.message || data.error)) || 'Could not start payment.', redirectUrl: redir };
                }
                if (!res.ok) {
                    var errorMsg = (data && (data.message || data.error)) || ('Payment service is currently unavailable (' + res.status + '). Please try again or choose Cash on Delivery.');
                    throw { message: errorMsg, redirectUrl: (data && data.redirectUrl) || null };
                }
                return data;
            });
        })
        .then(function (order) {
            // order is the CreateRazorpayOrderResponse from the API
            openRazorpayCheckout(order, aft);
        })
        .catch(function (err) {
            isSubmitting = false;
            primaryBtn.disabled = false;
            updatePaymentUI();
            showError(err.message || 'Unable to initiate payment. Please try again.', err.redirectUrl || null);
        });
    }

    // ── Step 2: Open Razorpay Standard Checkout ───────────────────────────────
    function openRazorpayCheckout(order, aft) {
        var primaryBtn = document.getElementById('primaryBtn');

        var options = {
            key:         order.keyId,
            amount:      order.amountPaise,
            currency:    order.currency || 'INR',
            order_id:    order.razorpayOrderId,
            name:        'GOLIS Mart',
            description: 'Order #' + order.internalOrderNumber,
            prefill: {
                name:    order.customerName  || '',
                email:   order.customerEmail || '',
                contact: (order.customerPhone || '').replace(/^\+91/, '').replace(/\D/g, '')
            },
            theme: { color: '#28a745' },

            handler: function (response) {
                // ── Step 3: Verify signature via MVC proxy ─────────────────────
                primaryBtn.disabled = true;
                primaryBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Verifying payment…';

                fetch('/checkout/razorpay/verify', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': aft
                    },
                    body: JSON.stringify({
                        razorpayOrderId:   response.razorpay_order_id,
                        razorpayPaymentId: response.razorpay_payment_id,
                        razorpaySignature: response.razorpay_signature
                    })
                })
                .then(function (res) {
                    return res.text().then(function (text) {
                        var data;
                        try {
                            data = JSON.parse(text);
                        } catch (e) {
                            data = null;
                        }

                        if (res.status === 401) throw { message: 'Your session expired during payment. Please contact support if you were charged.', redirectUrl: '/account/login' };
                        if (!res.ok) throw { message: (data && (data.message || data.error)) || 'Verification failed.' };
                        return data;
                    });
                })
                .then(function (result) {
                    sessionStorage.removeItem('gm_rzp_idem');
                    if (result.success) {
                        showSuccess('Payment successful! Redirecting to your order…');
                        setTimeout(function () {
                            window.location.href = '/order/confirmation/' + result.internalOrderId;
                        }, 1200);
                    } else {
                        isSubmitting = false;
                        primaryBtn.disabled = false;
                        updatePaymentUI();
                        showError(result.message || 'Payment verification failed. Please contact support.');
                    }
                })
                .catch(function (err) {
                    isSubmitting = false;
                    primaryBtn.disabled = false;
                    updatePaymentUI();
                    showError(err.message || 'Payment verification failed. Please try again or choose COD.', err.redirectUrl || null);
                });
            },

            modal: {
                ondismiss: function () {
                    isSubmitting = false;
                    primaryBtn.disabled = false;
                    updatePaymentUI();
                    showError('Payment was cancelled. You can try again or choose Cash on Delivery.');
                }
            }
        };

        try {
            var rzp = new window.Razorpay(options);
            rzp.on('payment.failed', function (response) {
                isSubmitting = false;
                primaryBtn.disabled = false;
                updatePaymentUI();
                var reason = (response.error && response.error.description) || 'Payment failed.';
                showError('Payment failed: ' + reason + '. Please try again or choose Cash on Delivery.');
            });
            rzp.open();
        } catch (e) {
            isSubmitting = false;
            primaryBtn.disabled = false;
            updatePaymentUI();
            showError('Could not open payment window. Please try again.');
        }
    }

    // ── UUID v4 helper ─────────────────────────────────────────────────────────
    function generateUuid() {
        if (window.crypto && window.crypto.randomUUID) return window.crypto.randomUUID();
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16 | 0;
            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
    }

})();
</script>
}
