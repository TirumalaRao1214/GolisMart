<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — GOLIS Mart" : "GOLIS Mart — Fresh Groceries Delivered")</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GOLISMart.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div id="gm-progress-bar" class="gm-progress-bar" aria-hidden="true"></div>

    @await Html.PartialAsync("_Header")

    <main id="main-content" class="gm-main-content" role="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")
    @await Html.PartialAsync("_Toast")
    @await Html.PartialAsync("_LocationModal")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    <script src="~/js/delivery.js" asp-append-version="true"></script>
    <script src="~/js/account.js" asp-append-version="true"></script>
    <script src="~/js/spa.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
