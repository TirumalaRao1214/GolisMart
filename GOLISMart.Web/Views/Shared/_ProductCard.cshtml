@* _ProductCard.cshtml — Professional product card partial
   Model: GOLISMart.Web.Services.ProductSummaryDto *@
@model GOLISMart.Web.Services.ProductSummaryDto
@{
    var hasOffer = Model.OfferPrice.HasValue;
    var discountPct = (hasOffer && Model.Price > 0)
        ? (int)Math.Round((Model.Price - Model.OfferPrice!.Value) / Model.Price * 100)
        : 0;
    var displayPrice = Model.OfferPrice ?? Model.Price;
}
<div class="gm-product-card">
    @* Discount badge *@
    @if (hasOffer && discountPct > 0)
    {
        <span class="gm-product-badge" aria-label="@discountPct% discount">@discountPct% OFF</span>
    }

    @* Image — links to detail page *@
    <a asp-controller="Product" asp-action="Detail" asp-route-slug="@Model.Slug"
       class="text-decoration-none d-block" tabindex="-1" aria-hidden="true">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="gm-product-img-wrap">
                <img src="@Model.ImagePath" alt="@Model.Name"
                     loading="lazy"
                     width="300" height="225"
                     onerror="this.onerror=null;this.closest('.gm-product-img-wrap').innerHTML='<div class=\'gm-product-img-placeholder\'><svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'1.5\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><polyline points=\'21 15 16 10 5 21\'/></svg></div>'" />
            </div>
        }
        else
        {
            <div class="gm-product-img-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                </svg>
            </div>
        }
    </a>

    @* Card body *@
    <div class="gm-product-card-body">
        <a asp-controller="Product" asp-action="Detail" asp-route-slug="@Model.Slug"
           class="text-decoration-none">
            <div class="gm-product-name">@Model.Name</div>
        </a>
        <div class="gm-product-unit">@Model.UnitLabel</div>

        @* Stock chip *@
        @if (!Model.IsInStock)
        {
            <span class="gm-stock-chip gm-chip-outstock">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                Out of stock
            </span>
        }
        else if (Model.IsLowStock)
        {
            <span class="gm-stock-chip gm-chip-lowstock">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Low stock
            </span>
        }

        @* Pricing *@
        <div class="gm-product-pricing">
            <span class="gm-product-price">&#8377;@displayPrice.ToString("N0")</span>
            @if (hasOffer)
            {
                <span class="gm-product-original">&#8377;@Model.Price.ToString("N0")</span>
            }
        </div>
    </div>

    @* Add to cart footer *@
    <div class="gm-product-card-foot">
        @if (Model.IsInStock)
        {
            <form method="post" asp-controller="Cart" asp-action="Add">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="quantity" value="1" />
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <button type="submit" class="gm-add-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 001.97 1.61h9.72a2 2 0 001.97-1.61L23 6H6"/>
                    </svg>
                    Add
                </button>
            </form>
        }
        else
        {
            <button class="gm-add-btn" disabled>Unavailable</button>
        }
    </div>
</div>
