@* _Header.cshtml — Two-row header: top bar + scrollable category nav *@

@* ── Top bar ──────────────────────────────────────────────────────────── *@
<header class="gm-topbar" role="banner">
    <div class="gm-topbar-inner">

        @* Logo *@
        <a asp-controller="Home" asp-action="Index" class="gm-logo" aria-label="GOLIS Mart home">
            <span class="gm-logo-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 01-8 0"/>
                </svg>
            </span>
            <span>
                <span class="gm-logo-text">GOLIS Mart</span>
                <span class="gm-logo-tagline">Fresh &amp; Fast Delivery</span>
            </span>
        </a>

        @* Delivery location *@
        <button class="gm-location" type="button" data-bs-toggle="modal" data-bs-target="#gmLocationModal" aria-label="Set delivery location">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span class="gm-location-text">
                <span class="gm-location-label">Deliver to</span>
                <span id="headerDeliveryPincodeText">Enter Pincode</span>
            </span>
        </button>

        @* Search *@
        <div class="gm-search-container position-relative flex-grow-1" style="max-width:540px;">
            <form class="gm-search-form" id="gmHeaderSearchForm" method="get"
                  asp-controller="Catalog" asp-action="Search"
                  role="search" aria-label="Search products">
                <input class="gm-search-input" id="gmHeaderSearchInput" type="search" name="q"
                       placeholder="Search vegetables, fruits, dal, atta…"
                       value="@ViewData["SearchQuery"]"
                       aria-label="Search products"
                       autocomplete="off" />
                <button class="gm-search-btn" type="submit" aria-label="Search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </button>
            </form>
            <div id="gmSearchSuggestions" class="gm-search-suggestions shadow" style="display:none;" role="listbox" aria-label="Search suggestions"></div>
        </div>

        @* Nav actions *@
        <nav class="gm-nav-actions" aria-label="Site actions">
            <a asp-controller="Home" asp-action="Index" class="gm-nav-btn d-none d-lg-flex" title="Home">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span>Home</span>
            </a>

            @* Account *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown">
                    <button class="gm-nav-btn dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false"
                            title="My Account">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span class="d-none d-sm-block">@(User.Identity.Name?.Split(' ')[0] ?? "Account")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Overview">My Account</a></li>
                        <li><a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">My Orders</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Addresses">Addresses</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger fw-semibold" asp-controller="AdminDashboard" asp-action="Dashboard" asp-area="" data-no-spa="true">Admin Dashboard</a></li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline" data-no-spa="true">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">Sign Out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="gm-nav-btn" title="Sign In" data-no-spa="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                    <span class="d-none d-sm-block">Sign In</span>
                </a>
            }

            @* Cart *@
            <a asp-controller="Cart" asp-action="Index" class="gm-nav-btn gm-cart-wrap" title="Cart">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 001.97 1.61h9.72a2 2 0 001.97-1.61L23 6H6"/>
                </svg>
                @await Component.InvokeAsync("CartCount")
                <span class="d-none d-sm-block">Cart</span>
            </a>
        </nav>

        @* Mobile hamburger *@
        <button class="gm-hamburger" id="mobileMenuBtn" aria-label="Open menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

@* ── Category Navigation Bar ──────────────────────────────────────────── *@
<nav class="gm-catbar" aria-label="Category navigation">
    <div class="gm-catbar-inner">
        <a asp-controller="Catalog" asp-action="Index" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            All
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="fresh-vegetables" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2a10 10 0 01-6.88 9.5M12 22V12m0 0c0-5 5-8 9-6M12 12c0-5-5-8-9-6"/></svg>
            Vegetables
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="fresh-fruits" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="14" r="8"/><path d="M12 6V2m0 0c0 0 4-2 6 2"/></svg>
            Fruits
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="rice-and-atta" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            Rice &amp; Atta
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="dal-and-pulses" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><ellipse cx="12" cy="12" rx="10" ry="6"/></svg>
            Dal &amp; Pulses
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="dairy-and-eggs" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22c5.52 0 10-4.48 10-10S17.52 2 12 2 2 6.48 2 12s4.48 10 10 10z"/><path d="M12 8v4m0 4h.01"/></svg>
            Dairy &amp; Eggs
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="cooking-oils" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 2h6l1 7H8L9 2z"/><rect x="6" y="9" width="12" height="13" rx="2"/><line x1="12" y1="13" x2="12" y2="17"/></svg>
            Cooking Oils
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="spices-and-masalas" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Spices
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="snacks-packaged-foods" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M8 8V6a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
            Snacks
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="beverages" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
            Beverages
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="household-essentials" class="gm-catbar-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
            Household
        </a>
    </div>
</nav>

@* ── Mobile nav drawer ──────────────────────────────────────────────────── *@
<div class="gm-mobile-nav" id="mobileNav" role="dialog" aria-label="Navigation menu" aria-modal="true">
    <div class="gm-mobile-nav-backdrop" id="mobileNavBackdrop"></div>
    <div class="gm-mobile-nav-panel">
        <div class="gm-mobile-nav-close">
            <span style="font-weight:700;font-size:1rem;">Menu</span>
            <button id="mobileNavClose" style="background:none;border:none;font-size:1.4rem;cursor:pointer;color:#374151;" aria-label="Close menu">&times;</button>
        </div>
        <a asp-controller="Home" asp-action="Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
            Home
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Account" asp-action="Overview">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                My Account (@(User.Identity.Name?.Split(' ')[0] ?? "User"))
            </a>
            <a asp-controller="Order" asp-action="MyOrders">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                My Orders
            </a>
            <a asp-controller="Account" asp-action="Addresses">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Addresses
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="AdminDashboard" asp-action="Dashboard" class="text-danger fw-semibold" data-no-spa="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Admin Dashboard
                </a>
            }
            <form asp-controller="Account" asp-action="Logout" method="post" style="padding: 10px 18px;" data-no-spa="true">
                @Html.AntiForgeryToken()
                <button type="submit" style="background:none;border:none;color:#dc2626;font-size:0.95rem;cursor:pointer;padding:0;display:flex;align-items:center;gap:8px;font-weight:600;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Sign Out
                </button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" data-no-spa="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Sign In
            </a>
        }
        <a asp-controller="Catalog" asp-action="Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            All Products
        </a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="fresh-vegetables">Vegetables</a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="fresh-fruits">Fruits</a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="rice-and-atta">Rice &amp; Atta</a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="dal-and-pulses">Dal &amp; Pulses</a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="dairy-and-eggs">Dairy &amp; Eggs</a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="cooking-oils">Cooking Oils</a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="spices-and-masalas">Spices &amp; Masalas</a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="snacks-packaged-foods">Snacks</a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="beverages">Beverages</a>
        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="household-essentials">Household</a>
    </div>
</div>
