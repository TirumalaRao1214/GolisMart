@* _LocationModal.cshtml — Delivery pincode check & location picker modal *@
<div class="modal fade" id="gmLocationModal" tabindex="-1" aria-labelledby="gmLocationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="gmLocationModalLabel">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="2" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
                    </svg>
                    Choose Delivery Location
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="text-muted small mb-3">
                    Enter your PIN code to check delivery availability and estimated delivery windows in your area.
                </p>

                <form id="gmHeaderPincodeForm" onsubmit="return false;">
                    <div class="input-group mb-3">
                        <input type="text" id="gmHeaderPincodeInput" class="form-control"
                               placeholder="Enter 6-digit PIN code" maxlength="6" inputmode="numeric"
                               aria-label="Enter 6-digit PIN code" />
                        <button type="button" id="gmHeaderPincodeSubmit" class="btn btn-success px-4">
                            Check
                        </button>
                    </div>
                </form>

                <div id="gmHeaderPincodeResult" style="display:none;" class="mt-2"></div>

                <div class="mt-3 pt-3 border-top">
                    <div class="small fw-semibold text-muted mb-2">Serviceable Areas (Bengaluru Demo):</div>
                    <div class="d-flex flex-wrap gap-1" id="gmQuickPins">
                        <button type="button" class="btn btn-sm btn-outline-secondary gm-quick-pin" data-pin="560001">560001 MG Road</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary gm-quick-pin" data-pin="560011">560011 Koramangala</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary gm-quick-pin" data-pin="560034">560034 Jayanagar</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary gm-quick-pin" data-pin="560068">560068 Whitefield</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary gm-quick-pin" data-pin="560100">560100 Electronic City</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
