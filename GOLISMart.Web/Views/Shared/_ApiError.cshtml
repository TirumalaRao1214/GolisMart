@* _ApiError.cshtml — Friendly API unavailable message *@
<div class="container py-5">
    <div class="gm-api-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="#92400e" stroke-width="1.5" stroke-linecap="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <h5>We're having trouble loading this page</h5>
        <p class="mb-1">Our product service is temporarily unavailable. Please try again in a moment.</p>
        <a href="javascript:location.reload()" class="gm-btn-secondary mt-2" style="display:inline-flex;">
